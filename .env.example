# Valores publicos obtidos em Supabase > Project Settings > API Keys.
# Nunca adicione sb_secret_... ou service_role em variaveis NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO
# Chave secreta da OpenAI, somente no servidor.
OPENAI_API_KEY=
# Endereço privado para diagnóstico de leitura; somente no servidor.
BILL_READING_WEBHOOK_URL=
